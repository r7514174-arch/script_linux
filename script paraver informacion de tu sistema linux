import subprocess

print ("INFORMACION DEL SISTEMA")
print ("------------------------------")

print ( "\n PROCESADOR ")
print ("------------------------------")
subprocess.run(["lscpu"])

print (" MEMORIA RAM")
print ("------------------------------")
subprocess.run(["free","-h"])

print (" \nDISCOS ")
print ("------------------------------")
subprocess.run(["lsblk"])

print (" \nTARJETA  ")
print ("------------------------------")
subprocess.run(["lspci"])


