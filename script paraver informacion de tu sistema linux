print ("------------------------------")
subprocess.run(["ps","aux"])


print ("\n PROGRAMAS INSTALADOS ")
print ("-----------------------------")
subprocess.run("dpkg -l | head -20", shell=True)

print ("\n CONSUMO DE RECURSOS")
subprocess.run(["top", "-bn1"])
